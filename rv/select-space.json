document.addEventListener('click',e=>{let pop=document.getElementById('symbol-popup');if(pop&&!pop.contains(e.target)){pop.remove();return;}let p=document.caretPositionFromPoint?document.caretPositionFromPoint(e.clientX,e.clientY):null,r=p?{n:p.offsetNode,o:p.offset}:(r=document.caretRangeFromPoint?document.caretRangeFromPoint(e.clientX,e.clientY):null)?{n:r.startContainer,o:r.startOffset}:null;if(!r||r.n.nodeType!==3)return;let t=r.n.textContent,o=r.o;if(o>t.length||t[o]!==' ')return;let s=o,eIdx=o,l=t.length;while(s>0&&t[s-1]===' ')s--;while(eIdx<l&&t[eIdx]===' ')eIdx++;if(s>=eIdx)return;if(pop)pop.remove();let np=document.createElement('div');np.id='symbol-popup';np.style.cssText=`position:absolute;top:${e.pageY-40}px;left:${e.pageX-30}px;background:#333;padding:4px;border-radius:4px;display:flex;gap:4px;z-index:99999;`;['/','•'].forEach(sym=>{let btn=document.createElement('button');btn.innerText=sym;btn.style.cssText='background:#fff;border:none;padding:4px 8px;cursor:pointer;font-weight:bold;';btn.onclick=()=>{let rg=document.createRange();rg.setStart(r.n,s),rg.setEnd(r.n,eIdx);let sel=window.getSelection();sel.removeAllRanges();sel.addRange(rg);document.execCommand('insertText',false,' '+sym+' ');np.remove();};np.appendChild(btn);});document.body.appendChild(np);});window.addEventListener('scroll',()=>{let pop=document.getElementById('symbol-popup');if(pop)pop.remove();});
