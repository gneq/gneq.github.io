"const s = document.defaultView.getSelection(); if (s.rangeCount > 0) { const range = s.getRangeAt(0); if (!range.collapsed) { const hrBefore = document.createElement('hr'); const hrAfter = document.createElement('hr'); const startRange = range.cloneRange(); startRange.collapse(true); startRange.insertNode(hrBefore); const endRange = range.cloneRange(); endRange.collapse(false); endRange.insertNode(hrAfter); s.removeAllRanges(); } }"
